# 배포된 사이트 주소 (이메일 링크 생성용, 로컬 개발 시 생략 가능)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API (평가용)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 이메일 (Ivy 알림용) - Resend 사용 시
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
RESEND_FROM_EMAIL=onboarding@resend.dev

# 문장 풀 잔여 개수 경고 기준치
POOL_LOW_THRESHOLD=20

# Cron 보호용 시크릿 (Vercel Cron 요청 검증)
CRON_SECRET=

# 카카오 공유하기 (developers.kakao.com > 내 애플리케이션 > JavaScript 키)
# 없으면 공유 버튼이 자동으로 네이티브 공유/링크 복사로 대체됨
NEXT_PUBLIC_KAKAO_JS_KEY=
